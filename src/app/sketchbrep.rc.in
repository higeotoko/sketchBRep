// Windows resources of SketchBRep.exe: the icon (Explorer, taskbar) and
// the version shown in the file's properties.
#include <winver.h>

IDI_ICON1 ICON "@SBR_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", "SketchBRep"
      VALUE "FileDescription", "SketchBRep - architectural B-rep modeler"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "SketchBRep"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "SketchBRep.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
