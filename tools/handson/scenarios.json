          "expect": {
            "contains": [
              "告示第266号 2、6 地域",
              "熱効率 87.8％以上",
              "モード熱効率 77.8％以上",
              "比消費電力 0.3 W/(m3/h) 以下",
              "非居室に白熱灯",
              "浴室・台所・洗面所が見当たりません"
