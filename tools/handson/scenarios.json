    {
      "id": "14-29・30・33・35・37・38・39",
      "title": "断熱範囲図（平面・断面）と断熱仕様表・開口部仕様表",
      "docs": "docs/216〜230",
      "look": "波線と×の範囲が断熱の印として読めるか。断熱仕様表・開口部仕様表の列と書き方が申請先の様式に合うか。告示の値（AI は本文と照らし済み）の書き方で伝わるか。",
      "base": [
        "house"
      ],
      "steps": [
        {
          "tool": "set_insulation",
          "args": {
            "ids": "$walls.ids",
            "material": "グラスウール 16K",
            "thickness_mm": 105,
            "conductivity": 0.038,
            "placement": "fill",
            "source": "確認用カタログ"
          }
        },
        {
          "tool": "set_insulation",
          "args": {
            "ids": [
              "$slab.id"
            ],
            "material": "押出法ポリスチレンフォーム 3種",
            "thickness_mm": 90,
            "conductivity": 0.028,
            "placement": "fill",
            "source": "確認用カタログ"
          }
        },
        {
          "tool": "set_opening_performance",
          "args": {
            "host": "$walls.ids.0",
            "u_value": 2.33,
            "glass": "Low-E 複層",
            "solar_gain": 0.51,
            "source": "確認用カタログ"
          }
        },
        {
          "tool": "render_drawing_set",
          "args": {
            "sheet": "断熱範囲図（1FL）",
            "texts": true
          },
          "picture": "断熱範囲図（1FL）",
          "expect": {
            "contains": [
              "断熱仕様表",
              "開口部仕様表",
              "グラスウール 16K",
              "R≧2.2",
              "満たす",
              "U=2.33",
              "η=0.51"
