{
  "about": "docs/246: the hands-on checklist (docs/105) as steps the AI runs through MCP. Each item: a new document, the 'base' steps, its own steps; 'expect' is what the AI checks (contains / not_contains in the answer and, for render_drawing_set with texts, the sheet's words; fails: the tool must refuse); 'picture' keeps the answer's picture in the report; 'look' is what only the owner can judge.",
  "bases": {
    "house": [
      {"tool": "set_levels", "args": {"levels": [{"name": "1FL", "elevation": 0}, {"name": "2FL", "elevation": 3000}]}},
      {"tool": "create_wall", "args": {"points": [[0, 0], [8000, 0], [8000, 6000], [0, 6000], [0, 0]], "thickness": 200, "height": 3000}, "save": "walls"},
      {"tool": "create_wall", "args": {"points": [[4000, 0], [4000, 6000]], "thickness": 100, "height": 3000}, "save": "partition"},
      {"tool": "place_openings", "args": {"host": "$walls.ids.0", "face_normal": [0, -1, 0], "count": 2, "width": 1600, "height": 1200, "sill": 900}},
      {"tool": "set_opening_fittings", "args": {"host": "$walls.ids.0", "fitting": {"type": "sliding_double"}}},
      {"tool": "place_openings", "args": {"host": "$walls.ids.1", "face_normal": [1, 0, 0], "count": 1, "width": 900, "height": 2100, "sill": 0}},
      {"tool": "set_opening_fittings", "args": {"host": "$walls.ids.1", "fitting": {"type": "swing_single", "hinge": "left", "swing": "in"}}},
      {"tool": "create_slab", "args": {"outline": [[0, 0], [8000, 0], [8000, 6000], [0, 6000]], "top": 0, "thickness": 200}, "save": "slab"},
      {"tool": "create_room", "args": {"at": [2000, 3000], "name": "居間"}, "save": "living"},
      {"tool": "create_room", "args": {"at": [6000, 3000], "name": "洋室"}, "save": "bedroom"},
      {"tool": "create_polygon", "args": {"points": [[-2000, -2000, 0], [14000, -2000, 0], [14000, 10000, 0], [-2000, 10000, 0]]}, "save": "site"},
      {"tool": "set_site_boundary", "args": {"outline": "$site.id", "source": "確認用の架空の測量図"}},
      {"tool": "set_energy_route", "args": {"route": "spec", "region": 6, "source": "確認用"}}
    ]
  },
  "scenarios": [
    {
      "id": "14-29・30・33・35・37・38・39",
      "title": "断熱範囲図（平面・断面）と断熱仕様表・開口部仕様表",
      "docs": "docs/216〜230",
      "look": "波線と×の範囲が断熱の印として読めるか。断熱仕様表・開口部仕様表の列と書き方が申請先の様式に合うか。告示の値（AI は本文と照らし済み）の書き方で伝わるか。",
      "base": ["house"],
      "steps": [
        {"tool": "set_insulation", "args": {"ids": "$walls.ids", "material": "グラスウール 16K", "thickness_mm": 105, "conductivity": 0.038, "placement": "fill", "source": "確認用カタログ"}},
        {"tool": "set_insulation", "args": {"ids": ["$slab.id"], "material": "押出法ポリスチレンフォーム 3種", "thickness_mm": 90, "conductivity": 0.028, "placement": "fill", "source": "確認用カタログ"}},
        {"tool": "set_opening_performance", "args": {"host": "$walls.ids.0", "u_value": 2.33, "glass": "Low-E 複層", "solar_gain": 0.51, "source": "確認用カタログ"}},
        {"tool": "render_drawing_set", "args": {"sheet": "断熱範囲図（1FL）", "texts": true}, "picture": "断熱範囲図（1FL）",
         "expect": {"contains": ["断熱仕様表", "開口部仕様表", "グラスウール 16K", "R≧2.2", "満たす", "U=2.33", "η=0.51"]}},
        {"tool": "render_drawing_set", "args": {"sheet": "断熱範囲図（A-A 断面）", "texts": true}, "picture": "断熱範囲図（A-A 断面）",
         "expect": {"contains": ["波線：壁の断熱", "波線：床の断熱"]}}
      ]
    },
    {
      "id": "14-34・46・47",
      "title": "機器表と仕様基準（告示第266号 2）の参考、浴室・台所・洗面所が無い時",
      "docs": "docs/224・238・239",
      "look": "機器表の列と書き方が申請で使う様式に合うか。表の下の告示の基準の注が多すぎて読みにくくないか。",
      "base": ["house"],
      "steps": [
        {"tool": "set_equipment", "args": {"items": [
          {"kind": "heating_cooling", "name": "ルームエアコン", "model": "AC-28xxx", "value": "エネルギー消費効率区分（い）", "count": 2, "source": "確認用カタログ"},
          {"kind": "ventilation", "name": "壁付式第三種換気設備", "value": "比消費電力 0.3"},
          {"kind": "hot_water", "name": "電気ヒートポンプ給湯機", "value": "JIS効率 3.3"},
          {"kind": "lighting", "name": "LED ダウンライト"}]}},
        {"tool": "render_drawing_set", "args": {"sheet": "機器表", "texts": true}, "picture": "機器表（6 地域、浴室・台所・洗面所なし）",
         "expect": {"contains": ["告示第266号 2、6 地域", "熱効率 87.8％以上", "モード熱効率 77.8％以上", "比消費電力 0.3 W/(m3/h) 以下", "非居室に白熱灯", "浴室・台所・洗面所が見当たりません"]}},
        {"tool": "rename", "args": {"id": "$bedroom.id", "name": "キッチン"}},
        {"tool": "render_drawing_set", "args": {"sheet": "機器表", "texts": true},
         "expect": {"not_contains": ["見当たりません"]}},
        {"tool": "permit_checks", "args": {"stage": 9}, "expect": {"contains": ["入力済み"]}}
      ]
    },
    {
      "id": "14-36",
      "title": "設備の機器の窓を、人と同じに開いて入れる",
      "docs": "docs/226・242",
      "look": "窓の表で入れやすいか。種類の選び方・台数・性能値の書き方で迷わないか（窓の絵を見て）。",
      "base": [],
      "steps": [
        {"tool": "ui_trigger", "args": {"action": "equipmentAction"}, "ui": true},
        {"tool": "ui_capture", "args": {"window": "modal"}, "picture": "設備の機器の窓（開いたところ）"},
        {"tool": "ui_set", "args": {"window": "modal", "widget": "equipmentTable", "row": 0, "column": 1, "value": "ルームエアコン"}},
        {"tool": "ui_set", "args": {"window": "modal", "widget": "equipmentTable", "row": 0, "column": 4, "value": 2}},
        {"tool": "ui_set", "args": {"window": "modal", "widget": "equipmentTable", "row": 2, "column": 1, "value": "電気ヒートポンプ給湯機"}},
        {"tool": "ui_capture", "args": {"window": "modal"}, "picture": "設備の機器の窓（入れたところ）"},
        {"tool": "ui_click", "args": {"window": "modal", "widget": "OK"}, "ui": true},
        {"tool": "list_equipment", "args": {}, "expect": {"contains": ["ルームエアコン", "電気ヒートポンプ給湯機"]}}
      ]
    },
    {
      "id": "14-27・40・41",
      "title": "計画概要の項目の窓と、計画概要の表・表題欄",
      "docs": "docs/214・231・232",
      "look": "窓の欄の順・書き方が第二号様式に合うか。足りない欄は無いか。欄が多くて入れにくくないか。",
      "base": ["house"],
      "steps": [
        {"tool": "capture_window", "args": {"window": "project_outline"}, "picture": "計画概要の項目の窓"},
        {"tool": "set_project_outline", "args": {"items": {"project_name": "確認用の家", "client": "確認 太郎", "main_use": "一戸建ての住宅", "structural_review": "not_required", "energy_plan": "submitted"}}},
        {"tool": "render_drawing_set", "args": {"sheet": 2, "texts": true}, "picture": "計画概要",
         "expect": {"contains": ["確認用の家", "確認 太郎", "一戸建ての住宅"]}},
        {"tool": "permit_checks", "args": {"stage": 9}, "show": true, "expect": {"contains": ["省エネ適判"]}}
      ]
    },
    {
      "id": "14-28",
      "title": "省エネの適用ルート・地域の窓、断熱の窓",
      "docs": "docs/215",
      "look": "画面から迷わず入れられるか（窓の絵を見て）。",
      "base": ["house"],
      "steps": [
        {"tool": "capture_window", "args": {"window": "energy_route"}, "picture": "省エネの適用ルート・地域の窓"},
        {"tool": "select", "args": {"ids": "$walls.ids"}},
        {"tool": "capture_window", "args": {"window": "insulation"}, "picture": "断熱を入れる窓（外壁 4 枚を選んで）"}
      ]
    },
    {
      "id": "14-42・43・44",
      "title": "付近見取図（見本の座標：東京駅。オーナーの敷地ではない）",
      "docs": "docs/233〜235",
      "look": "地図・丸・目標物の出方、縮尺・範囲・出典の書き方で申請に足りるか。本当の敷地の座標での確認はオーナーが。",
      "base": ["house"],
      "steps": [
        {"tool": "set_vicinity_map", "args": {"lat": 35.681236, "lon": 139.767125, "zoom": 16, "layer": "std", "marks": [{"name": "見本の目標物", "lat": 35.6800, "lon": 139.7650}]}},
        {"tool": "capture_window", "args": {"window": "vicinity_map"}, "picture": "付近見取図の位置の窓"},
        {"tool": "render_drawing_set", "args": {"sheet": "付近見取図", "texts": true}, "picture": "付近見取図（見本の座標）",
         "expect": {"contains": ["国土地理院", "見本の目標物"]}}
      ]
    },
    {
      "id": "14-45",
      "title": "天井断熱",
      "docs": "docs/236",
      "look": "天井の範囲・波線・「天井」の行の出方。天井板に断熱を付ける形で困らないか。",
      "base": ["house"],
      "steps": [
        {"tool": "set_room_finish", "args": {"id": "$living.id", "ceiling_height": 2400}},
        {"tool": "make_ceilings", "args": {"rooms": ["$living.id"]}, "save": "ceilings"},
        {"tool": "select", "args": {"ids": "$ceilings.ids"}},
        {"tool": "capture_window", "args": {"window": "insulation"}, "picture": "断熱を入れる窓（天井を選んで）"},
        {"tool": "set_insulation", "args": {"ids": "$ceilings.ids", "material": "グラスウール 16K", "thickness_mm": 155, "conductivity": 0.038, "placement": "fill", "source": "確認用カタログ"}},
        {"tool": "render_drawing_set", "args": {"sheet": "断熱範囲図（1FL）", "texts": true}, "picture": "断熱範囲図（1FL）天井断熱",
         "expect": {"contains": ["天井断熱", "×印の範囲：この階の天井の断熱", "天井", "R≧4.0", "満たす"]}},
        {"tool": "render_drawing_set", "args": {"sheet": "断熱範囲図（A-A 断面）", "texts": true}, "picture": "断熱範囲図（A-A 断面）天井断熱",
         "expect": {"contains": ["波線：天井の断熱"]}}
      ]
    }
  ]
